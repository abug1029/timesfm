# 凭证
.env
.env.*

# Python
__pycache__/
*.pyc
*.pyo
.venv/
*.egg-info/

# 数据库（太大，不适合 git）
# SSOT 软链整目录（指向 timesFM_fu/db）
/db
db/*.db
db/*.db-shm
db/*.db-wal

# TimesFM 子仓库（独立 git 仓库，不作为子模块）
timesfm/

# TimesFM 模型缓存
timesfm_cache/

# OMC 内部状态
.omc/
.superpowers/
.claude/
.agents/

# Praxist 运行产物（太大，可从 praxist 重新生成）
task_FM/experiments/
task_FM/scripts/praxist_ws/

# 模型权重（pkl 太大）
models/*.pkl

# pytest
.pytest_cache/

# 预测报告（按需取消注释以提交）
reports/

# 数据缓存
data/cache/

# 其他运行时状态
task_state.json
ralph/

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db
.env.praxist
.praxist-venv/
models/timesfm-*/

# Praxist report dumps (md + pdf) — keep on disk, do not commit
task_FM/docs/praxist_reports/20260904_*
task_FM/docs/praxist_reports/*.pdf

# Aligned verdict registry (runtime / slow-loop writable)
task_FM/config/aligned_verdicts.jsonl

# mem_guard install artifacts inside venv (venv dir already ignored; belt+suspenders)
**/.praxist-venv/**/zz_fm_mem_guard*
**/.praxist-venv/**/*.pth
**/zz_fm_mem_guard.pth
**/zz_fm_mem_guard_loader.py
