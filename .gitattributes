# ── 受保护路径 (backup merge 防误删) ─────────────────────────
# backup 机的 cleanup commit 曾两次误删 cascade/ scripts/ tests/ 的改进代码
# (69f28f7 10-29, dbb68b5 11-01)。这些路径在 merge 时如果冲突，
# 默认采用当前分支版本 (ours)，防止 backup 侧的 code rollback 污染 master。
# 备份侧若真有改进，需走 PR review 显式接受，不能通过 backup merge 自动吸收。
#
# merge driver "protected-ours" 需在 .git/config 注册:
#   [merge "protected-ours"]
#       name = protected: keep current-branch version on conflict
#       driver = true   # true = 退出码 0 但不修改工作树 → 保留 ours
cascade/**              merge=protected-ours
scripts/**              merge=protected-ours
tests/**                merge=protected-ours
docs/superpowers/**     merge=protected-ours
#
# ── 关键配置/数据（防止 backup cleanup 误删）─────────────────
# backup cleanup 曾删 baseline_metrics.json / family_registry.jsonl / data/config.py
# 这些文件被覆盖时 merge 冲突应保留本机版本，避免无声丢失
data/*.py                    merge=protected-ours
task_FM/config/family_registry.jsonl    merge=protected-ours
task_FM/config/baseline_metrics.json    merge=protected-ours
task_FM/config/covariate_pool.json      merge=protected-ours
